# Vercel env for apps/site (production).
# Set this in Vercel project settings → Environment Variables → Production.
#
# This is the only secret apps/site needs — every /api/* call is reverse-
# proxied to the bounty backend (see apps/site/next.config.js).

# Public Tailscale Funnel URL of the GPU box (printed by scripts/start.sh
# after `tailscale funnel status`).
BOUNTY_ORIGIN=https://gpu-server.tailec11d1.ts.net

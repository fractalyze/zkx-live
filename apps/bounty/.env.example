# Copy to .env.local and fill in.

# The repo whose stargazers earn the bounty.
GITHUB_REPO=octocat/Hello-World

# How many lamports (or SPL token base units) to send per claim.
BOUNTY_AMOUNT=5000000

# Solana RPC. localnet by default; switch to https://api.devnet.solana.com
# (or your own RPC) when going off-machine.
SOLANA_RPC_URL=http://127.0.0.1:8899

# Bounty wallet — base58 secret key (Phantom export format) OR a JSON array of
# 64 bytes (solana-keygen format). The agent signs payment txs with this key.
# DO NOT commit a real secret here.
BOUNTY_WALLET_SECRET=

# Internal services (default to local).
WITNESS_URL=http://127.0.0.1:7001
PROVER_URL=http://127.0.0.1:9090

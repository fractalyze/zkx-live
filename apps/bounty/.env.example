# Copy to .env.local and fill in.

# ── GitHub OAuth ───────────────────────────────────────────────────────
# Register an OAuth app at https://github.com/settings/developers
#   Application name:           zkx-live dev
#   Homepage URL:               http://localhost:13000
#   Authorization callback URL: http://localhost:13000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the app is reachable from a user's browser (used to build OAuth
# redirect_uri). Local dev with port-shifted ssh forwarding → :13000.
APP_URL=http://localhost:13000

# Random 32+ bytes used to HMAC-sign the session cookie.
# Generate with: openssl rand -base64 32
COOKIE_SECRET=

# ── Bounty config ──────────────────────────────────────────────────────
GITHUB_REPO=fractalyze/zkx-live
BOUNTY_AMOUNT=10000000          # lamports
BOUNTY_AMOUNT_HUMAN=0.01 SOL

# ── Solana ─────────────────────────────────────────────────────────────
SOLANA_RPC_URL=http://127.0.0.1:8899

# Bounty wallet — base58 secret OR JSON array of 64 bytes (solana-keygen
# format). Agent signs payments with this key.
BOUNTY_WALLET_SECRET=

# ── Internal services ──────────────────────────────────────────────────
WITNESS_URL=http://127.0.0.1:7001
PROVER_URL=http://127.0.0.1:9090

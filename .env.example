# Copy to .env.local and edit as needed.
# Same vars apply to SDK, prover-service, and demo apps.

# ====================================================================
# Cluster selection — switches RPC, program ID, USDC mint, prover URL
# ====================================================================
# One of: localnet | devnet | testnet | mainnet
ZKX_GUARDRAIL_CLUSTER=devnet

# ====================================================================
# Per-field overrides (optional — defaults loaded from sdk/src/config.ts)
# ====================================================================
# ZKX_GUARDRAIL_RPC_URL=https://api.devnet.solana.com
# ZKX_GUARDRAIL_PROGRAM_ID=GRdRL11111111111111111111111111111111111111
# ZKX_GUARDRAIL_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# ZKX_GUARDRAIL_ZKX_ENDPOINT=https://prove-dev.zkx.example

# ====================================================================
# Prover-service-only
# ====================================================================
# PROVER_PORT=7000
# PROVER_BACKEND=zkx              # 'zkx' | 'snarkjs' | 'rapidsnark'
# CIRCUIT_WASM=../circuits/build/pay_static_js/pay_static.wasm
# CIRCUIT_ZKEY=../circuits/build/pay_static_final.zkey

# ====================================================================
# Demo-app-only
# ====================================================================
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_GUARDRAIL_PROGRAM_ID=GRdRL11111111111111111111111111111111111111

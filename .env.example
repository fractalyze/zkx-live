# Production stack env. Copied to .env (gitignored) and read by:
#   - docker compose --env-file .env
#   - scripts/start.sh
#
# .env is also the file Vercel-side reads via `apps/site/.env.production` —
# only BOUNTY_ORIGIN there.

# ── GitHub OAuth app ──────────────────────────────────────────────────
# https://github.com/settings/developers
# Authorization callback URL must be:  ${APP_URL}/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# What the *user's browser* sees as the bounty origin. In production
# this is the Tailscale Funnel URL (printed by start.sh), e.g.
# APP_URL=https://gpu-server.tailec11d1.ts.net
APP_URL=

# Random string used by lib/session to sign the auth cookie.
COOKIE_SECRET=

# ── Solana / claim flow ───────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
ATTESTOR_PRIV_HEX=

# ── Bounty config ─────────────────────────────────────────────────────
GITHUB_REPO=fractalyze/zkx-live
BOUNTY_AMOUNT=5000000
BOUNTY_AMOUNT_HUMAN=5 USDC
